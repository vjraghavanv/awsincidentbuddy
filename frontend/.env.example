# Base URL of the deployed API Gateway endpoint (no trailing slash).
# Leave empty for local development (Vite proxies /analyze to sam local).
# Example: https://abc123.execute-api.us-east-1.amazonaws.com
VITE_API_URL=

# Set to "true" to run with NO backend using built-in client-side demo
# analysis. Ideal for a standalone Amplify demo. Leave empty/false to call
# the real API at VITE_API_URL.
VITE_USE_MOCK=
